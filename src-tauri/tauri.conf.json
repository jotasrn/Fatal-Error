{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fatal Error",
  "version": "1.7.1",
  "identifier": "com.fatalerror.game",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fatal Error",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-frame-rate-limit --disable-gpu-vsync --enable-gpu-rasterization"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../build/icon.ico",
      "../build/icon.png"
    ]
  }
}

