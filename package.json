{
  "name": "fatal-error",
  "version": "1.3.9",
  "description": "Fatal Error — arena shooter 3D (Electron + Hyperswarm P2P).",
  "main": "electron/main.cjs",
  "author": "jotasrn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jotasrn/Fatal-Error.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder --win nsis zip --publish never",
    "release": "electron-builder --win nsis zip --publish always"
  },
  "dependencies": {
    "b4a": "^1.6.6",
    "electron-updater": "^6.8.11",
    "hyperswarm": "^4.8.4"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.fatalerror.game",
    "productName": "Fatal Error",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/afterPack.cjs",
      "src/**/*",
      "vendor/**/*",
      "build/icon.png",
      "build/favicon.png",
      "index.html",
      "style.css"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/sodium-native/**",
      "**/node_modules/udx-native/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Fatal-Error-Portable-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Fatal-Error-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fatal Error"
    },
    "publish": {
      "provider": "github",
      "owner": "jotasrn",
      "repo": "Fatal-Error",
      "releaseType": "release"
    },
    "afterPack": "electron/afterPack.cjs"
  }
}
